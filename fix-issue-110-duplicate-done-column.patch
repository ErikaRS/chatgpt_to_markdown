diff --git a/src/ui/columns/tests/columns.tests.ts b/src/ui/columns/tests/columns.tests.ts
index f351c92..f7b77b5 100644
--- a/src/ui/columns/tests/columns.tests.ts
+++ b/src/ui/columns/tests/columns.tests.ts
@@ -1,8 +1,68 @@
 import { describe, expect, it } from "vitest";
 import { get } from "svelte/store";
-import { createCollapsedColumnsStore, resolveDefaultColumnName } from "../columns";
+import { createCollapsedColumnsStore, createColumnStores, resolveDefaultColumnName } from "../columns";
 import { createSettingsStore, defaultSettings } from "../../settings/settings_store";
 
+describe("createColumnStores", () => {
+	it("maps custom columns to their kebab-cased keys", () => {
+		const settingsStore = createSettingsStore();
+		settingsStore.set({ ...defaultSettings, columns: ["Backlog", "Working", "Review"] });
+		const { columnTagTable } = createColumnStores(settingsStore);
+
+		const table = get(columnTagTable);
+		expect(table["backlog"]).toBe("Backlog");
+		expect(table["working"]).toBe("Working");
+		expect(table["review"]).toBe("Review");
+	});
+
+	it("includes 'done' in columnTagTable when 'Done' is in columns (for task tag matching)", () => {
+		const settingsStore = createSettingsStore();
+		settingsStore.set({ ...defaultSettings, columns: ["Backlog", "Working", "Review", "Done"] });
+		const { columnTagTable } = createColumnStores(settingsStore);
+
+		// "done" must be in the table so tasks tagged #done are recognised as column-assigned
+		const table = get(columnTagTable);
+		expect(table["done"]).toBe("Done");
+		expect(Object.keys(table)).toContain("done");
+	});
+
+	it("handles column specs with hex color codes", () => {
+		const settingsStore = createSettingsStore();
+		settingsStore.set({ ...defaultSettings, columns: ["Todo(#FF0000)", "Done(0x00FF00)"] });
+		const { columnTagTable, columnColourTable } = createColumnStores(settingsStore);
+
+		const table = get(columnTagTable);
+		expect(table["todo"]).toBe("Todo");
+		expect(table["done"]).toBe("Done");
+
+		const colours = get(columnColourTable);
+		expect(colours["todo"]).toBe("#FF0000");
+		expect(colours["done"]).toBe("#00FF00");
+	});
+
+	it("returns empty tables when columns is empty", () => {
+		const settingsStore = createSettingsStore();
+		settingsStore.set({ ...defaultSettings, columns: [] });
+		const { columnTagTable } = createColumnStores(settingsStore);
+
+		expect(Object.keys(get(columnTagTable))).toHaveLength(0);
+	});
+
+	it("updates reactively when column settings change", () => {
+		const settingsStore = createSettingsStore();
+		settingsStore.set({ ...defaultSettings, columns: ["Todo"] });
+		const { columnTagTable } = createColumnStores(settingsStore);
+
+		expect(get(columnTagTable)["todo"]).toBe("Todo");
+
+		settingsStore.set({ ...defaultSettings, columns: ["Backlog", "Working"] });
+		const updated = get(columnTagTable);
+		expect(updated["todo"]).toBeUndefined();
+		expect(updated["backlog"]).toBe("Backlog");
+		expect(updated["working"]).toBe("Working");
+	});
+});
+
 describe("resolveDefaultColumnName", () => {
 	it("returns default 'Uncategorized' when no custom name is set", () => {
 		expect(resolveDefaultColumnName("uncategorised", undefined, undefined)).toBe("Uncategorized");
